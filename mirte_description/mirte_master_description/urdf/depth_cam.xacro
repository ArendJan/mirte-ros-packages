<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
   <link
    name="Depth_camera">
    <inertial>
      <origin
        xyz="-0.139364988710438 -0.0173680519512047 0.02215464323049"
        rpy="0 0 0" />
      <mass
        value="2.88121038233162" />
      <inertia
        ixx="0.0585330875030336"
        ixy="-0.00149512396123631"
        ixz="-0.0193738145471712"
        iyy="0.0651097389054094"
        iyz="-0.00303065037585006"
        izz="0.0625793114760086" />
    </inertial>
  <!-- <visual>
  <geometry>
                         <box size="0.1 .1 0.1" />
                    </geometry>
  </visual> -->
  </link>
  <joint
    name="Depth_camera_joint"
    type="fixed">
    <origin
      xyz="0.194919101935334 -0.0242159015133965 -0.00814738065306653"
      rpy="0 0 2.66843002436935E-05" />
    <parent
      link="base_link" />
    <child
      link="Depth_camera" />
    <axis
      xyz="0 0 0" />
  </joint>



     <xacro:property name="orbbec_astra_mini_pro_scale" value="1.0" />
     <!-- RGB sensor - cam -->
     <!-- THESE MIGHT NEED TO CHANGE IF THE RESOLUTION IS NOT 640x480 -->
     <xacro:property name="orbbec_astra_mini_pro_rel_rgb_px" value="0.0" />
     <xacro:property name="orbbec_astra_mini_pro_rel_rgb_py" value="-0.0125" />
     <xacro:property name="orbbec_astra_mini_pro_rel_rgb_pz" value="-0.0150" />


     <!-- IR sensor - depth -->
     <xacro:property name="orbbec_astra_mini_pro_depth_rel_rgb_px" value="0.0" />
     <xacro:property name="orbbec_astra_mini_pro_depth_rel_rgb_py" value="0.0250" />
     <xacro:property name="orbbec_astra_mini_pro_depth_rel_rgb_pz" value="0.0" />
     <xacro:property name="M_PI" value="3.1415926535897931" />

     <xacro:macro name="sensor_orbbec_astra_mini_pro"
          params="name parent *origin color rgb_w:=640 rgb_h:=480 stddev:=0.5">

          <joint name="${name}_rgb_joint" type="fixed">
               <xacro:insert_block name="origin" />
               <parent link="${parent}" />
               <child link="${name}_rgb_frame" />
          </joint>

          <link name="${name}_rgb_frame">
               <inertial>
                    <mass value="0.001" />
                    <origin xyz="0 0 0" />
                    <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
               </inertial>
          </link>

          <joint name="${name}_rgb_optical_joint" type="fixed">
               <!-- <origin xyz="0.0 0.0 0.0" rpy="${-M_PI/2} 0 ${-M_PI/2}" /> -->
               <!-- <origin -->
               <parent link="${name}_rgb_frame" />
               <child link="${name}_rgb_optical_frame" />
          </joint>

          <link name="${name}_rgb_optical_frame">
               <!--inertial>
                    <mass value="0.001" />
                    <origin xyz="0 0 0" />
                    <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
               </inertial-->
          </link>

          <joint name="${name}_joint" type="fixed">
               <origin
                    xyz="${orbbec_astra_mini_pro_rel_rgb_px} ${orbbec_astra_mini_pro_rel_rgb_py} ${orbbec_astra_mini_pro_rel_rgb_pz}"
                    rpy="0.0 0 0" />
               <parent link="${name}_rgb_frame" />
               <child link="${name}_link" />
          </joint>

          <link name="${name}_link">
               <!-- <visual>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                         <mesh
                              filename="package://mirte_master_description/meshes/BR.STL" />
                    </geometry>
                    <material name="${color}" />
               </visual> -->
               <collision>
                    <origin xyz="-0.0183 0.0 0.0165" rpy="0 0 0" />
                    <geometry>
                         <box size="0.0370 .1650 0.0350" />
                    </geometry>
               </collision>
               <inertial>
                    <mass value="0.564" />
                    <origin xyz="0 0 0" />
                    <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0"
                         izz="0.003879257" />
               </inertial>
          </link>

          <joint name="${name}_depth_joint" type="fixed">
               <origin
                    xyz="${orbbec_astra_mini_pro_depth_rel_rgb_px} ${orbbec_astra_mini_pro_depth_rel_rgb_py} ${orbbec_astra_mini_pro_depth_rel_rgb_pz}"
                    rpy="0 0 0" />
               <parent link="${name}_rgb_frame" />
               <child link="${name}_depth_frame" />
          </joint>

          <link name="${name}_depth_frame">
               <!--inertial>
                    <mass value="0.01" />
                    <origin xyz="0 0 0" />
                    <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
               </inertial-->
          </link>

          <joint name="${name}_depth_optical_joint" type="fixed">
               <!-- <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" /> -->
               <parent link="${name}_depth_frame" />
               <child link="${name}_depth_optical_frame" />
          </joint>

          <link name="${name}_depth_optical_frame">
               <!--inertial>
                    <mass value="0.001" />
                    <origin xyz="0 0 0" />
                    <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
               </inertial-->
          </link>

          <!-- RGBD sensor for simulation, same as Kinect -->
          <xacro:sensor_orbbec_astra_mini_pro_gazebo />

     </xacro:macro>

     <!-- ====================================================
                           Gazebo
     ========================================================= -->

     <xacro:macro name="sensor_orbbec_astra_mini_pro_gazebo">
          <gazebo reference="${name}_depth_frame">
             <sensor name="${name}" type="rgbd_camera">
                <visualize>true</visualize>
                <update_rate>10.0</update_rate>
                <topic>/${name}/depth_image</topic>
                <gz_frame_id>${name}_depth_frame</gz_frame_id>
                <camera name="RS_D455">
                    <horizontal_fov>${60.0*M_PI/180.0}</horizontal_fov>
                    <image>
                        <width>${rgb_w}</width>
                        <height>${rgb_h}</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>10.0</far>
                    </clip>
                </camera>
            </sensor>
            </gazebo>
            <!-- <gazebo reference="${name}_rgb_optical_frame">
            <sensor name="${name}_color" type="camera">
                <visualize>true</visualize>
                <update_rate>10.0</update_rate>
                <topic>/${name}/image_raw</topic>
                <gz_frame_id>${name}_rgb_optical_frame</gz_frame_id>
                <camera name="RS_D455">
                    <horizontal_fov>${60.0*M_PI/180.0}</horizontal_fov>
                    <image>
                        <width>${rgb_w}</width>
                        <height>${rgb_h}</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>10.0</far>
                    </clip>
                </camera>
            </sensor>
         </gazebo> -->
     </xacro:macro>
    <xacro:sensor_orbbec_astra_mini_pro name="rgbd_camera" parent="Depth_camera" color="blue">
      <origin xyz="0.0 -0.0 0.0" rpy="1.570 0 0" />
    </xacro:sensor_orbbec_astra_mini_pro>

  </robot>