<?xml version="1.0"?>
<!-- Copied from github:ArendJan/mirte-gazebo branch rsp -->
<!-- Modified to remove the collision and change the minimum distance -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
  <xacro:macro name="mecanum_wheel" params="name *origin link_origin wheel_type">

  <link
    name="${name}_wheel">
    <!-- <inertial>
          <origin xyz="0 0 ${link_origin}" />

          <mass value="2">2</mass
          </inertia>
        </inertial> -->
    <inertial>
      <origin xyz="0 0 ${link_origin}" />
      <mass value="${wheel_mass}" />
      <inertia
        ixx="${wheel_mass * (3 * (wheel_radius**2) + (wheel_length**2)) / 12}"
        iyy="${wheel_mass * (3 * (wheel_radius**2) + (wheel_length**2)) / 12}"
        izz="${wheel_mass * (wheel_radius **2) / 2}"
        ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <geometry>
      <xacro:if value="${wheel_type == 'left'}">
        <mesh
          filename="package://mirte_master_description/meshes/BR.STL" />
      </xacro:if>
      <xacro:if value="${wheel_type == 'right'}">
        <mesh
          filename="package://mirte_master_description/meshes/BL.STL" />
      </xacro:if>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 ${link_origin} 0" rpy="${pi/2} 0 0" />
      <geometry>
        <sphere radius="${wheel_radius}" />
        <!-- <cylinder radius="${wheel_radius}" length="${wheel_length}" /> -->
      </geometry>
      <!-- <surface>
            <friction>
              <!- - <ode> -  ->
              <!- - sdfa;ladsfkljasfdkjlasfdlkjasfd - ->
              <mu>1.0</mu>
                <!- - <mu2>1.0</mu2> - ->
                <xacro:if value="${wheel_type == 'left'}">
                  <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
                                  

                </xacro:if>
                <xacro:if value="${wheel_type == 'right'}">
                  <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>

                </xacro:if>

              <!- - </ode> - ->
            </friction>
          </surface> -->
    </collision>
  </link>

  <joint
    name="${name}_wheel_joint"
    type="continuous">
    <xacro:insert_block name="origin"/>
    <parent link="Wheels" />
    <child link="${name}_wheel" />
    <axis xyz="0 1 0" />
  </joint>

  <transmission name="${name}_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="${name}_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="${name}_wheel_actuator">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  </xacro:macro>
</robot>
