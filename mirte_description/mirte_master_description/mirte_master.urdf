      <param name="single_update_name">/io/set_multiple_motor_speeds</param>
      <param name="encoder_topic_format">/io/encoder/%s</param>
      <param name="use_topic_update">True</param>
      <param name="use_single_update">True</param>
      <param name="cmd_vel_deadzone">10</param>
      <param name="cmd_vel_update_deadzone">1</param>
      <param name="max_rot_speed">18.84</param>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
