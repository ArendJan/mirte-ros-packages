  <ros2_control name="mecanumdrive" type="system">
    <hardware>
      <plugin>mirte_base_control/MirteBaseHWInterface</plugin>
      <param name="ticks">1320</param>
      <param name="separate_update_format">/io/motor/set_%s_speed</param>
