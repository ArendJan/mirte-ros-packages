<?xml version="1.0"?>
<!-- 4 Wheel Robot with front steering and rear drive -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mirte_dart_robot">
  <xacro:arg name="prefix" default="" />

  <xacro:include filename="$(find mirte_dart_control)/urdf/mirte_dart_description.urdf.xacro" />

  <!-- Import Rviz colors -->
  <xacro:include filename="$(find mirte_dart_control)/urdf/mirte_dart.materials.xacro" />

  <!-- Import mirte_dart ros2_control description -->
  <xacro:include filename="$(find mirte_dart_control)/ros2_control/mirte_dart_control_ros2_control.xacro" />

  <xacro:mirte_dart prefix="$(arg prefix)" />
   <xacro:mirte_dart_ros2_control
    name="MIRTEonDART" prefix="$(arg prefix)" /> 

</robot>
